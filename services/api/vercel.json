{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "git": { "deploymentEnabled": false },
  "buildCommand": "npm run vendor && mkdir -p public && echo 'Smart Container API. See /api/v1/openapi' > public/index.html",
  "installCommand": "npm install",
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 30,
      "memory": 1024
    }
  },
  "outputDirectory": "public"
}
